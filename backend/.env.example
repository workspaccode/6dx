# 6DX backend — copy to .env and fill in.
#
#   cp .env.example .env
#
# Never commit .env or the files under secrets/.

# --- server ---------------------------------------------------------------
ADDR=:8080
# Public base URL of THIS service, used to build the GitHub OAuth redirect.
PUBLIC_BASE_URL=http://localhost:8080
# Comma separated allow-list; use your web app origin in production.
CORS_ORIGINS=*
API_PORT=8080

# --- database -------------------------------------------------------------
# SQLite: a single file. No server, no container, nothing to install.
# Point it anywhere writable (or /data/6dx.db inside Docker).
DATABASE_FILE=./6dx.db
# Apply the embedded migrations when the API boots.
MIGRATE_ON_STARTUP=true

# --- Firebase (token verification only) -----------------------------------
# Service account JSON from Firebase console → Project settings → Service
# accounts → Generate new private key.
#
# Only needed while sessions issued by the old Firebase sign-in still exist;
# the app now signs in with GitHub, and its grant is verified by calling the
# GitHub API (no Firebase round trip per request).
FIREBASE_PROJECT_ID=apps-41d38
# Leave empty unless legacy Firebase sessions must keep working: a path to a
# missing file stops the server at start-up.
FIREBASE_CREDENTIALS_FILE=

# --- GitHub sign-in (device flow) -----------------------------------------
# Client id of the OAuth app / GitHub App the app signs in with. The device
# flow endpoints are proxied by this API, so the id never ships in the bundle.
# Enable "Device Flow" in the app settings or GitHub answers
# `device_flow_disabled`.
GITHUB_CLIENT_ID=
# Required: every sign-in token is checked with GitHub
# (POST /applications/{client_id}/token) to prove it was issued to this app.
# Without the secret no GitHub sign-in is accepted.
GITHUB_CLIENT_SECRET=

# --- GitHub App (optional) ------------------------------------------------
# Without these every /github/* route fails closed; the rest of the API works.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Either paste the PEM here (with \n escapes) or point at a file.
GITHUB_PRIVATE_KEY_FILE=./secrets/github-app.private-key.pem
GITHUB_WEBHOOK_SECRET=
# Must match the App's "Callback URL" exactly.
GITHUB_OAUTH_REDIRECT=http://localhost:8080/github/callback
# Recommended: a separate random value (openssl rand -hex 32). Defaults to
# GITHUB_WEBHOOK_SECRET. Changing it invalidates in-flight installs only.
GITHUB_STATE_SECRET=

# --- Deployment ------------------------------------------------------------
# development (default) | production. Production refuses to start with
# CORS_ORIGINS=*, an http:// PUBLIC_BASE_URL / GITHUB_OAUTH_REDIRECT, missing
# GitHub sign-in credentials, or a state secret equal to the webhook secret.
APP_ENV=development
# Stage 1 (server by IP):  http://<server-ip>:8080
# Stage 2 (domain):        https://api.<domain>
# PUBLIC_BASE_URL=
# Stage 2 only: the domain Caddy requests a certificate for, and bind the API
# port to localhost so only HTTPS is public.
# API_DOMAIN=api.example.com
# API_BIND=127.0.0.1

# Reverse proxies allowed to set X-Forwarded-For (CIDRs or IPs). Empty = the
# API is reached directly and the TCP peer is the client. docker-compose sets
# it to its own network (Caddy).
TRUSTED_PROXIES=

# Requests per minute per client IP.
RATE_LIMIT_SIGNIN_PER_MIN=30
RATE_LIMIT_API_PER_MIN=600

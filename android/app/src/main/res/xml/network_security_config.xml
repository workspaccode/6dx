<?xml version="1.0" encoding="utf-8"?>
<!--
  6DX network policy — PRODUCTION (HTTPS only).

  This is the default for release builds. Local-network builds use
  network_security_config_lan.xml instead; android/app/build.gradle.kts picks
  the file (see `sixdx.allowCleartext`).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
